<resources>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#7C4DFF</item>
    </style>
    <style name="RateCode">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="RateValue">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/widget_text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="CompactRateRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">3dp</item>
    </style>
    <style name="CompactRateCode" parent="RateCode">
        <item name="android:textSize">13sp</item>
    </style>
    <style name="CompactRateValue" parent="RateValue">
        <item name="android:textSize">15sp</item>
    </style>
    <style name="ExpandedRateRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">10dp</item>
    </style>
    <style name="ExpandedRateCode" parent="RateCode">
        <item name="android:textSize">18sp</item>
    </style>
    <style name="ExpandedRateValue" parent="RateValue">
        <item name="android:textSize">22sp</item>
    </style>
</resources>
